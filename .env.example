# ==============================================================================
# Go Worker Template - Environment Configuration Template
# Copy this file to .env for local overrides (loaded automatically by mise).
# In production/K8s, supply these values via container environment / ConfigMaps / Secrets.
# ==============================================================================

# Application Environment (development | staging | production | test)
APP_ENV=development
LOG_LEVEL=info

# Broker Selection & Consumer Settings
BROKER_KIND=postgres_outbox
CONSUMER_GROUP=default-worker-group
WORKER_CONCURRENCY=10
BATCH_SIZE=10
POLL_INTERVAL=1s
PROCESSING_TIMEOUT=30s

# Retry & Dead Letter Queue (DLQ)
MAX_RETRIES=3
DLQ_QUEUE_NAME=tasks_dlq
IDEMPOTENCY_TTL=168h

# RabbitMQ Settings (active when BROKER_KIND=rabbitmq)
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_QUEUE=tasks_queue
RABBITMQ_PREFETCH_COUNT=20


# Redpanda / Kafka Settings (active when BROKER_KIND=redpanda or BROKER_KIND=kafka)
KAFKA_BROKERS=localhost:9092
KAFKA_TOPICS=tasks
# Health/Metrics Probe Server & Lifecycle
PROBE_PORT=8081
SHUTDOWN_TIMEOUT=30s

# PostgreSQL Credentials & Connection
POSTGRES_USER=postgres
POSTGRES_PASSWORD=S3cr3tP455w0rD
POSTGRES_DB=worker_db
DATABASE_URL=postgres://postgres:S3cr3tP455w0rD@localhost:5432/worker_db?sslmode=disable

# PostgreSQL Pool Settings
DB_MAX_CONNS=25
DB_MIN_CONNS=2
DB_MAX_CONN_LIFETIME=30m
DB_MAX_CONN_IDLE_TIME=5m
DB_HEALTH_CHECK_PERIOD=1m
DB_PING_TIMEOUT=5s
